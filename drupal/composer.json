{
    "name": "drupal-composer/drupal-project",
    "description": "Project template for Drupal 8 projects with composer",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "",
            "role": ""
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.6.5",
        "drupal/action": "^1.0",
        "drupal/admin_toolbar": "^3",
        "drupal/betterlogin": "^2.0",
        "drupal/block_field": "^1.0",
        "drupal/classy": "^2.0",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recommended": "^11",
        "drupal/ctools": "^4.0",
        "drupal/date_popup": "^2.0",
        "drupal/draggableviews": "^2.0",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/entity_reference_revisions": "^1.5",
        "drupal/feeds": "^3.0",
        "drupal/field_group": "^3.0",
        "drupal/geolocation": "^3.0",
        "drupal/multiple_fields_remove_button": "^2.0",
        "drupal/paragraphs": "^1.3",
        "drupal/pathauto": "^1.3",
        "drupal/restui": "^1.15",
        "drupal/search_autocomplete": "^4.0",
        "drupal/select2": "^2.0",
        "drupal/smtp": "^1.0",
        "drupal/twig_xdebug": "^1.2",
        "drupal/viewfield": "^3.0@beta",
        "drupal/views_autocomplete_filters": "^2.0",
        "drupal/views_bulk_edit": "^3.0",
        "drupal/views_bulk_operations": "^4.0",
        "drupal/views_data_export": "^1.0",
        "drupal/views_entity_form_field": "^1.0",
        "drupal/views_field_formatter": "^4.0",
        "drush/drush": "^13",
        "mpdf/mpdf": "^8.0",
        "npm-asset/gsap": "^2.1",
        "npm-asset/select2": "4.1.0-RC.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "vlucas/phpdotenv": "^5.0",
        "webflo/drupal-finder": "^1.0.0",
        "webmozart/path-util": "^2.3"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true
        }
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ],
        "files": ["load.environment.php"]
    },
    "scripts": {
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ]
    },
    "extra": {
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/{$name}": ["type:drupal-drush"]
        },
        "installer-types": ["bower-asset", "npm-asset"],
        "drupal-scaffold": {
            "initial": {
                ".editorconfig": "../.editorconfig",
                ".gitattributes": "../.gitattributes"
            }
        },
        "patches": {
          "drupal/core": {
            "Fix mb_strtolower null deprecation in config entity query": "patches/fix-config-entity-query-null-strtolower.patch"
          },
          "drupal/paragraphs": {
            "Mod add multiple to paragraphs": "patches/mod_add_multiple_paragraphs.patch"
          },
          "drupal/draggableviews": {
            "Mod fix broken index on weight": "patches/mod-fix-broken-index-on-drag-weight.patch",
            "Mod remove multi display support because relations dont support it": "patches/mod-no-multi-view-display-support.patch"
          },
          "drupal/views_entity_form_field": {
            "Fix broken submit handlers when draggableviews installed": "patches/fix-entity-form-submit-handlers.patch",
            "Move submit to custom button": "patches/move-submit-to-custom-button.patch",
            "Mod call draggable views submit directly": "patches/mod-call-draggable-views-submit-directly-if-needed.patch"
          }
        }
    }
}
